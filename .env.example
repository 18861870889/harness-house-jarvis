OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Dev server
PORT=5173

# Runtime safety
# Default is dry_run. Set to real only when you intentionally want low-risk provider actions to reach real devices.
HARNESS_EXECUTION_MODE=dry_run
# HARNESS_EXECUTION_MODE=real

# Home Assistant Adapter
# HA_BASE_URL=http://homeassistant.local:8123
# HA_TOKEN=your_long_lived_access_token

# Optional experimental native D1 decision backend. No cloud fallback in this mode.
# HARNESS_DECISION_BACKEND=d1
# D1_ENDPOINT=http://192.168.1.154:8080/v1/systemone
# D1_MODEL=d1-3b-q4
# D1_TIMEOUT_MS=1800
# HARNESS_D1_DEMO=1
# Demo uses memory only. Use HARNESS_EXECUTION_MODE=real to allow memory changes;
# dry_run still previews without changing the simulated device state.
