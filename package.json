{
  "name": "harness-house",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "demo:d1": "node scripts/start-d1-demo.mjs",
    "demo:sandbox": "node scripts/start-house-sandbox.mjs",
    "assets:sandbox": "node scripts/build-sandbox-assets.mjs",
    "test:sandbox:ui": "node scripts/test-house-sandbox.mjs",
    "test:sandbox:ha": "node scripts/test-ha-sandbox.mjs",
    "test:d1:live": "node scripts/test-d1-live.mjs",
    "test:harness": "vitest run src/experiments/harnessComparison.test.js src/experiments/harnessHardening.test.js src/experiments/d1IntentContext.test.js src/experiments/d1SemanticContext.test.js src/d1Client.test.js src/d1DecisionV2.test.js src/d1SemanticDecision.test.js",
    "test:d1:sandbox:live": "node scripts/evaluate-d1-sandbox.mjs",
    "test:d1:intent:live": "node scripts/evaluate-d1-intent.mjs",
    "soak:pi": "node --expose-gc scripts/soak-pi-harness.mjs",
    "compare:harness": "node scripts/compare-harnesses.mjs",
    "dev:vite": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "vitest run",
    "test:adapter": "vitest run src/adapters",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@vitejs/plugin-react": "^5.1.1",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.181.2",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.99.2",
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-session-backend-sqlite-node": "0.99.2",
    "@langchain/langgraph": "1.4.21",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "playwright-core": "^1.60.0",
    "vitest": "^4.1.8"
  }
}
